@{
    ViewData["Title"] = "Băng Tải";
}

<div class="list-searchroom">
    <div class="search-chart">
        <div class="search-date">
            <label for="startDate">Từ Ngày:</label>
            <input type="datetime-local" id="startDate" value="@ViewData["StartDate"]" onchange="filterByDate()" />
        </div>
        <div class="search-date">
            <label for="endDate">Đến Ngày:</label>
            <input type="datetime-local" id="endDate" value="@ViewData["EndDate"]" onchange="filterByDate()" />
        </div>
    </div>
    <div class="excel-control">
        <button onclick="exportToExcelBT()">Excel <img class="logo-drb" src="~/img/avatars/file-upload.png" alt="logo" /></button>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-top: 10px;">
        @TempData["Error"]
    </div>
}

<div class="checkbox-controls" style="color: white; background: black; display:flex; justify-content: center; align-items: center;">
    <label style="margin-right: 20px; color: rgb(54, 162, 235);">
        <input type="checkbox" id="hidePole" checked onchange="toggleDataset(0)"> Áp lực đá
    </label>
    <label style="margin-right: 20px; color: rgb(255, 159, 64);">
        <input type="checkbox" id="hideTension" checked onchange="toggleDataset(1)"> Áp lực bàn kẹp
    </label>
    <label style="margin-right: 20px; color: rgb(255, 99, 132); display: flex; align-items: center;">
        <span style="margin-right: 8px;">Trạng thái:</span>
        <label class="switch">
            <input type="checkbox" id="statusToggle" disabled
            @(ViewData["CB1_STATUS"] != null && ((List<int>)ViewData["CB1_STATUS"]).LastOrDefault() == 1 ? "checked" : "")>
            <span class="slider round"></span>
        </label>
        <span style="margin-left: 8px;">
            @(ViewData["CB1_STATUS"] != null && ((List<int>)ViewData["CB1_STATUS"]).LastOrDefault() == 1 ? "Bật" : "Tắt")
        </span>
    </label>
</div>

<div class="chart-container" style="height: 83vh; background: black;">
    <canvas id="bangTaiChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let chart;

    function filterByDate() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        if (startDate && endDate) {
            window.location.href = `/BangTai?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;
        }
    }

    function exportToExcelBT() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        if (!startDate || !endDate) {
            alert("Vui lòng chọn ngày bắt đầu và ngày kết thúc!");
            return;
        }
        window.location.href = `/BangTai/ExportToExcel?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;
    }

    function toggleDataset(index) {
        const meta = chart.getDatasetMeta(index);
        meta.hidden = !meta.hidden;
        chart.update();
    }

    const labels = @Html.Raw(Json.Serialize(ViewData["Labels"]));
    const apLucDa = @Html.Raw(Json.Serialize(ViewData["ApLucDa"]));
    const apLucBanKep = @Html.Raw(Json.Serialize(ViewData["ApLucBanKep"]));

    if (!labels || labels.length === 0) {
        document.getElementById('bangTaiChart').style.display = 'none';
        alert("Không có dữ liệu để hiển thị biểu đồ!");
    } else {
        const data = {
            labels: labels,
            datasets: [
                {
                    label: 'Áp lực đá',
                    data: apLucDa,
                    borderColor: 'rgb(54, 162, 235)',
                    backgroundColor: 'rgba(54, 162, 235, 0.5)',
                    fill: false,
                    tension: 0.1
                },
                {
                    label: 'Áp lực bàn kẹp',
                    data: apLucBanKep,
                    borderColor: 'rgb(255, 159, 64)',
                    backgroundColor: 'rgba(255, 159, 64, 0.5)',
                    fill: false,
                    tension: 0.1
                }
            ]
        };

        const config = {
            type: 'line',
            data: data,
            options: {
                plugins: {
                    legend: { display: false },
                    title: {
                        display: true,
                        text: 'Biểu đồ thông số Băng Tải',
                        color: 'white',
                        font: { size: 18, weight: 'bold' }
                    }
                },
                scales: {
                    x: {
                        display: true,
                        title: { display: true, text: 'Thời gian', color: 'white', font: { size: 14 } },
                        ticks: { color: 'white', maxRotation: 45, minRotation: 45 },
                        grid: { color: 'rgba(255, 255, 255, 0.2)' }
                    },
                    y: {
                        display: true,
                        title: { display: true, color: 'white', font: { size: 14 } },
                        ticks: { color: 'white' },
                        grid: { color: 'rgba(255, 255, 255, 0.2)' }
                    }
                }
            }
        };

        const ctx = document.getElementById('bangTaiChart').getContext('2d');
        chart = new Chart(ctx, config);
    }
</script>