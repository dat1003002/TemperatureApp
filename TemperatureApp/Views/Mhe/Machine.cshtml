@{
    ViewData["Title"] = ViewData["Title"] ?? "Máy Độ Nhớt";
    var action = ViewData["Action"] as string ?? "May1_1";
    var exportAction = ViewData["ExportAction"] as string ?? "Export1_1";
}

<div class="list-searchroom">
    <div class="search-chart">
        <div class="search-date">
            <label for="startDate">Từ Ngày:</label>
            <input type="datetime-local" id="startDate" value="@ViewData["StartDate"]" onchange="filterByDate()" />
        </div>
        <div class="search-date">
            <label for="endDate">Đến Ngày:</label>
            <input type="datetime-local" id="endDate" value="@ViewData["EndDate"]" onchange="filterByDate()" />
        </div>
    </div>
    <div class="excel-control">
        <button onclick="exportToExcelMHE()">
            Excel
            <img class="logo-drb" src="~/img/avatars/file-upload.png" alt="logo" />
        </button>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-top: 10px;">
        @TempData["Error"]
    </div>
}

<div class="checkbox-controls" style="color: white; background: black; display:flex; flex-wrap: wrap; justify-content: center; align-items: center; padding: 8px 0;">
    <span style="color:white; margin-right: 30px; font-weight:bold;">@ViewData["Title"]</span>
    <label style="margin-right: 30px; color: rgb(75, 192, 192);">
        <input type="checkbox" id="hideThucTe" checked onchange="toggleDataset(0)"> Thực tế
    </label>
    <label style="margin-right: 30px; color: rgb(255, 99, 132);">
        <input type="checkbox" id="hideTieuChuan" checked onchange="toggleDataset(1)"> Tiêu chuẩn
    </label>
    <label style="margin-right: 30px; color: rgb(255, 206, 86);">
        <input type="checkbox" id="hidePressure" checked onchange="toggleDataset(2)"> Áp lực
    </label>
</div>

<div class="chart-container" style="background: black; margin: 0; padding: 0;">
    <canvas id="mheChart"></canvas>
</div>

<script src="~/lib/chartjs/chart.umd.min.js"></script>
<script src="~/lib/chartjs/chartjs-adapter-date-fns.bundle.min.js"></script>

<script>
    const ACTION = "@action";
    const EXPORT_ACTION = "@exportAction";
    let chart;

    function filterByDate() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        if (startDate && endDate) {
            window.location.href = `/Mhe/${ACTION}?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;
        }
    }

    function exportToExcelMHE() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        if (!startDate || !endDate) {
            alert("Vui lòng chọn ngày bắt đầu và ngày kết thúc!");
            return;
        }
        window.location.href = `/Mhe/${EXPORT_ACTION}?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;
    }

    function toggleDataset(index) {
        if (!chart) return;
        const meta = chart.getDatasetMeta(index);
        meta.hidden = !meta.hidden;
        chart.update();
    }

    const labels = @Html.Raw(Json.Serialize(ViewData["Labels"]));
    const thucTe = @Html.Raw(Json.Serialize(ViewData["ThucTe"]));
    const tieuChuan = @Html.Raw(Json.Serialize(ViewData["TieuChuan"]));
    const ppm = @Html.Raw(Json.Serialize(ViewData["PPM"]));

    if (!labels || labels.length === 0) {
        document.getElementById('mheChart').style.display = 'none';
        alert("Không có dữ liệu để hiển thị biểu đồ!");
    } else {
        const data = {
            labels: labels,
            datasets: [
                {
                    label: 'Thực tế',
                    data: thucTe,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    fill: false,
                    tension: 0,
                    spanGaps: true,
                    normalized: true
                },
                {
                    label: 'Tiêu chuẩn',
                    data: tieuChuan,
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                    fill: false,
                    tension: 0,
                    spanGaps: true,
                    normalized: true
                },
                {
                    label: 'Áp lực',
                    data: ppm,
                    borderColor: 'rgb(255, 206, 86)',
                    backgroundColor: 'rgba(255, 206, 86, 0.1)',
                    fill: false,
                    tension: 0,
                    spanGaps: true,
                    normalized: true
                }
            ]
        };

        const config = {
            type: 'line',
            data: data,
            options: {
                maintainAspectRatio: false,
                animation: false,
                layout: {
                    padding: { left: 10, right: 15, top: 10, bottom: 10 }
                },
                plugins: {
                    legend: { display: false },
                    decimation: {
                        enabled: true,
                        algorithm: 'lttb',
                        samples: 1000,
                        threshold: 500
                    }
                },
                elements: {
                    point: { radius: 0 }
                },
                interaction: {
                    intersect: false,
                    mode: 'index'
                },
                scales: {
                    x: {
                        display: true,
                        title: { display: false },
                        ticks: {
                            color: 'white',
                            maxRotation: 0,
                            minRotation: 0,
                            autoSkip: false,
                            padding: 8,
                            callback: function(value, index, ticks) {
                                const total = ticks.length;
                                if (total <= 6) {
                                    return this.getLabelForValue(value);
                                }
                                const step = (total - 1) / 5;
                                const positions = [0, Math.round(step), Math.round(2*step), Math.round(3*step), Math.round(4*step), total-1];
                                if (!positions.includes(index)) return null;

                                const label = this.getLabelForValue(value);
                                const parts = label.split(' ');
                                if (parts.length >= 2) {
                                    const datePart = parts[0];
                                    let timePart = parts[1].substring(0, 5);
                                    return [timePart, datePart];
                                }
                                return label;
                            }
                        },
                        grid: { color: 'rgba(255, 255, 255, 0.2)' }
                    },
                    y: {
                        display: true,
                        title: { display: true, color: 'white', font: { size: 14 } },
                        ticks: { color: 'white' },
                        grid: { color: 'rgba(255, 255, 255, 0.2)' }
                    }
                }
            }
        };

        const ctx = document.getElementById('mheChart').getContext('2d');
        chart = new Chart(ctx, config);
    }
</script>
